# Copy to .env and fill in. Never commit .env.

# Apify API token (Console -> Settings -> API & Integrations). Used only server-side.
APIFY_TOKEN=
# Anthropic API key for resume analysis and job scoring. Without it a labelled heuristic is used.
ANTHROPIC_API_KEY=

# Scoring/analysis model: claude-sonnet-5-5 (default) or claude-opus-5-5 (higher quality, ~2x cost)
LLM_MODEL=claude-sonnet-5-5
# Hard cap on estimated Apify spend per run (USD). Runs whose estimate exceeds it are refused.
MAX_RUN_COST_USD=3.0

# SQLite by default; set a Postgres URL to use Postgres, e.g. postgresql://user:pass@host:5432/jobradar
DATABASE_URL=
# When set, runs execute in the arq worker (docker compose sets this). Empty = in-process background tasks.
REDIS_URL=

# Check robots.txt before every verification fetch; disallowed pages are marked "uncertain".
RESPECT_ROBOTS_TXT=true
# Anthropic server-side refusal fallback (beta). Set false to disable.
LLM_FALLBACKS=true
